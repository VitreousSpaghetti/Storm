<?xml version="1.0" encoding="utf-8"?>
<!-- Letto da mkpsxiso. Percorsi relativi alla cartella build; nomi file 8.3 maiuscoli. -->
<iso_project>
	<track type="data">
		<identifiers
			system			="PLAYSTATION"
			volume			="STORM"
			volume_set		="STORM"
			publisher		="GLITCHED_PSX_ISO"
			data_preparer	="PSN00BSDK ${PSN00BSDK_VERSION}"
			application		="PLAYSTATION"
			copyright		="README.TXT;1"
		/>

		<!-- Licenza PAL (o NTSC con -DNTSC=ON): senza, la PS1 col modchip rifiuta il disco. Vedi giochi_nuovi/LEGGIMI.md -->
		<license file="${PROJECT_SOURCE_DIR}/../${LICENZA}" />

		<directory_tree>
			<file name="SYSTEM.CNF"	type="data" source="${PROJECT_SOURCE_DIR}/../system.cnf" />
			<file name="MAIN.EXE"	type="data" source="storm.exe" />
			<dummy sectors="1024"/>
		</directory_tree>
	</track>
</iso_project>
